{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anti-Fire",
  "version": "1.0.0",
  "identifier": "org.twinbyte.antifire",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Anti-Fire",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": false,
        "create": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "category": "Productivity",
    "shortDescription": "Combustion in microgravity: calculations and NASA reports, on top of the SFSS service",
    "longDescription": "Anti-Fire is a working client of the SFSS service: burn rate calculations, batch runs from CSV and questions over NASA combustion reports with links to the source pages. It can start and stop a local SFSS itself.",
    "icon": [
      "icons/icon.icns",
      "icons/128x128.png",
      "icons/32x32.png"
    ]
  }
}
